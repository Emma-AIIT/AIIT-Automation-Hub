# Copy to .env (never commit .env) and fill in. See SETUP.md.

# Shared secret the Hub sends as ?key=... on every request. Generate with: openssl rand -hex 32
BRIDGE_SECRET=

# Public hostname Caddy gets an HTTPS certificate for. No domain needed: use your VM's
# public IP with dashes + .sslip.io, e.g. 203-0-113-10.sslip.io
BRIDGE_DOMAIN=

# Telegram user account (Ali's). api_id / api_hash from https://my.telegram.org -> API development tools.
# Leave all three empty to switch Telegram off (/telegram/* then answers 503).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Printed by `npm run telegram-login`. It is a full login to the account: keep it secret.
TELEGRAM_SESSION=

# Signal: the existing phone's number in +E.164 form (e.g. +61412345678) that the bridge is linked to.
# Leave empty to switch Signal off (/signal/* then answers 503).
SIGNAL_NUMBER=
