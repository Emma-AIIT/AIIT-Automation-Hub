# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.
# All variables must also be declared in /src/env.js.

# ─── Supabase ────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL="https://<your-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"

# ─── Make.com — Debt Recovery ─────────────────────────────────────────────────

# Xero sync — triggered by "Sync Now" button
MAKE_SYNC_WEBHOOK_URL="https://hook.eu2.make.com/..."

# Outreach trigger (future — manual outreach button)
MAKE_OUTREACH_WEBHOOK_URL=

# ─── Make.com — Tickets ───────────────────────────────────────────────────────

# Pull new tickets from Outlook inbox via Make.com
MAKE_PULL_TICKETS_WEBHOOK_URL="https://hook.eu2.make.com/..."

# Mark stale tickets — called by cron job daily
MAKE_STALE_TICKET_WEBHOOK_URL="https://hook.eu2.make.com/..."

# Send email reply via Outlook through Make.com
MAKE_SEND_EMAIL_WEBHOOK_URL="https://hook.eu2.make.com/..."

# ─── Make.com — Quote Pipeline ────────────────────────────────────────────────

# Fetch quotes from Xero (triggered on page load)
MAKE_QUOTE_PIPELINE_GET_WEBHOOK_URL="https://hook.eu2.make.com/..."

# Push quote status update back to Xero
MAKE_QUOTE_PIPELINE_UPDATE_WEBHOOK_URL="https://hook.eu2.make.com/..."

# ─── Make.com — WhatsApp (AIIT Automation account) ───────────────────────────

# SEND_MESSAGE = group broadcasts. SEND_PARTICIPANT_MESSAGE = individual 1:1 sends from the Participants page.
MAKE_WHATSAPP_PULL_GROUPS_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_SEND_MESSAGE_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_SEND_PARTICIPANT_MESSAGE_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_PULL_PARTICIPANTS_WEBHOOK_URL="https://hook.eu2.make.com/..."

# ─── Make.com — WhatsApp (Susu Closets account) ──────────────────────────────

MAKE_WHATSAPP_SUSU_PULL_GROUPS_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_SUSU_SEND_MESSAGE_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_SUSU_SEND_PARTICIPANT_MESSAGE_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_SUSU_PULL_PARTICIPANTS_WEBHOOK_URL="https://hook.eu2.make.com/..."

# ─── Make.com — WhatsApp (GIM Foundation account) ────────────────────────────

MAKE_WHATSAPP_GIM_PULL_GROUPS_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_GIM_SEND_MESSAGE_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_GIM_SEND_PARTICIPANT_MESSAGE_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_GIM_PULL_PARTICIPANTS_WEBHOOK_URL="https://hook.eu2.make.com/..."

# Failure alerts: WhatsApp broadcast/sync failures are emailed here via the
# MAKE_SEND_EMAIL_WEBHOOK_URL scenario. Leave unset to disable alert emails.
WHATSAPP_ALERT_EMAIL="you@example.com"

# ─── Make.com — WhatsApp (AIIT Business Account) ─────────────────────────────

MAKE_WHATSAPP_BUSINESS_PULL_GROUPS_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_BUSINESS_SEND_MESSAGE_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_BUSINESS_SEND_PARTICIPANT_MESSAGE_WEBHOOK_URL="https://hook.eu2.make.com/..."
MAKE_WHATSAPP_BUSINESS_PULL_PARTICIPANTS_WEBHOOK_URL="https://hook.eu2.make.com/..."

# ─── Messaging bridge — Telegram and Signal Broadcast tabs ───────────────────
# Full endpoint URLs of services/messaging-bridge (see its SETUP.md), each with the
# bridge secret as ?key=... The Hub calls these directly, no Make.com in between.
# A platform's Broadcast tab shows "isn't set up yet" until both its URLs are set.

# Telegram, sending from Ali's own account (GramJS)
TELEGRAM_BRIDGE_SYNC_GROUPS_URL="https://bridge.example.com/telegram/sync-groups?key=..."
TELEGRAM_BRIDGE_SEND_URL="https://bridge.example.com/telegram/send?key=..."
# Signal, sending from the linked number (signal-cli-rest-api)
SIGNAL_BRIDGE_SYNC_GROUPS_URL="https://bridge.example.com/signal/sync-groups?key=..."
SIGNAL_BRIDGE_SEND_URL="https://bridge.example.com/signal/send?key=..."

# Telegram direct mode (no bridge server): the Hub logs in as Ali's own account
# with GramJS on each refresh/send. When all three are set they take precedence
# over the TELEGRAM_BRIDGE_* URLs above. See HANDOVER.md "Telegram (direct)".
# api_id and api_hash from my.telegram.org > API development tools (Ali's number)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Printed by `npm run telegram-login`. A full login to the account: keep it
# secret, add it to Vercel with --sensitive, and never log it.
TELEGRAM_SESSION=

# ─── VAPI ─────────────────────────────────────────────────────────────────────

VAPI_API_KEY="<your-vapi-api-key>"

# ─── Security ─────────────────────────────────────────────────────────────────

# Bearer token for /api/whatsapp/import-participants-csv
WHATSAPP_IMPORT_SECRET="<generate-a-random-secret>"

# Bearer token for cron job endpoints (/api/stale-tickets, /api/cron/whatsapp)
CRON_SECRET="<generate-a-random-secret>"


# ─── OUTBOUND CALLS ───────────────────────────────────────────────────────────
# Shared secret VAPI echoes back on the per-call outcome webhook
VAPI_WEBHOOK_SECRET="<any long random string>"
# Absolute origin VAPI posts end-of-call reports to. Optional on Vercel:
# falls back to the project's production URL.
APP_PUBLIC_URL="https://aiit-automation-hub.vercel.app"
# Twilio, for the post-call SMS follow-ups
TWILIO_ACCOUNT_SID="<your-twilio-account-sid>"
TWILIO_AUTH_TOKEN="<your-twilio-auth-token>"
TWILIO_FROM_NUMBER="+61440138322"
# Internal copy of every call-outcome SMS
OPS_SMS_NUMBER="+61404502522"
# Post-call lead summary email
LEAD_SUMMARY_EMAIL="alit@allinit.com.au"

# Minutes between groups in a WhatsApp broadcast. Optional, defaults to 15.
# This is the interval that keeps the number off WhatsApp's ban radar. It is
# enforced by /api/cron/whatsapp - the Make.com send scenario must NOT contain
# Sleep modules, or the delays stack and every send is reported as a timeout.
WHATSAPP_BROADCAST_INTERVAL_MINUTES=15

# ─── SUBSCRIPTIONS (live billing checks) ──────────────────────────────────────
# Read-only keys the Subscriptions page uses to check each service's billing
# status when the hub is opened. All optional: a missing key falls back to the
# dates in src/config/subscriptions.ts. Twilio reuses TWILIO_ACCOUNT_SID/TOKEN.
# ElevenLabs: a key with only the "User: read" permission
ELEVENLABS_API_KEY=
# Make.com: API token with organizations:read (Profile > API access)
MAKE_API_KEY=
# Vercel: an access token with access to the "Emma's projects" team
VERCEL_API_TOKEN=
